<% layout("layouts/boilerplate") %>

<section class="listing-hero">
  <div class="hero-copy">
    <p class="eyebrow">Discover the next stay that sparks your adventure</p>
    <h1>Trending stays, iconic cities, mountain escapes and camping getaways</h1>
    <p>Use the search bar in navigation or filters below to find the perfect place for your next trip.</p>
  </div>
</section>

<div id="filters" class="category-row">
  <% const categories = [
      { name: 'Trending', icon: 'fa-fire' },
      { name: 'Rooms', icon: 'fa-bed' },
      { name: 'Iconic Cities', icon: 'fa-mountain-city' },
      { name: 'Mountains', icon: 'fa-mountain-sun' },
      { name: 'Castle', icon: 'fa-fort-awesome' },
      { name: 'Arctic', icon: 'fa-snowflake' },
      { name: 'Camping', icon: 'fa-campground' },
      { name: 'Farms', icon: 'fa-tractor' },
      { name: 'Domes', icon: 'fa-igloo' }
  ]; %>
  <% categories.forEach(category => { %>
    <button type="button" class="filter" data-category="<%= category.name %>">
      <i class="fa-solid <%= category.icon %>"></i>
      <span><%= category.name %></span>
    </button>
  <% }) %>
</div>

<div class="result-status">
  <span id="resultText"><%= allListings.length %> stays matched</span>
  <input id="searchInput" type="search" style="display: none;" />
</div>

<div class="listings-grid" id="listingsGrid">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link" data-title="<%= listing.title %>" data-location="<%= listing.location %>" data-country="<%= listing.country %>" data-category="<%= listing.category || 'Trending' %>">
      <div class="card listing-card animate-card">
        <div class="listing-badge"><%= listing.category || 'Trending' %></div>
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
        <div class="card-body">
          <div>
            <p class="card-title"><%= listing.title %></p>
            <p class="card-subtitle"><%= listing.location %>, <%= listing.country %></p>
          </div>
          <div class="card-footer">
            <span class="price-text">₹ <%= listing.price.toLocaleString('en-IN') %></span>
            <span class="tax-info">+18% GST</span>
          </div>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  const searchInput = document.getElementById('searchInput');
  const filterButtons = document.querySelectorAll('.filter');
  const listingCards = document.querySelectorAll('.listing-link');
  const resultText = document.getElementById('resultText');
  let activeCategory = 'Trending';

  function normalize(value) {
    return String(value || '').toLowerCase();
  }

  function deriveCategory(card) {
    const title = normalize(card.dataset.title);
    const location = normalize(card.dataset.location);
    const country = normalize(card.dataset.country);
    const text = `${title} ${location} ${country}`;

    if (/castle|fort|palace/.test(text)) return 'Castle';
    if (/arctic|snow|ice|glacier|polar/.test(text)) return 'Arctic';
    if (/camp|camping|tent|forest|campsite/.test(text)) return 'Camping';
    if (/farm|ranch|countryside/.test(text)) return 'Farms';
    if (/mountain|hill|valley|alpine|peak/.test(text)) return 'Mountains';
    if (/city|town|metro|urban/.test(text)) return 'Iconic Cities';
    if (/room|suite|bed|villa|home|cabin/.test(text)) return 'Rooms';
    return normalize(card.dataset.category) === 'trending' ? 'Trending' : card.dataset.category;
  }

  function updateResults(count, total) {
    resultText.textContent = `${count} of ${total} stays matched`;
  }

  function setActiveCategory(category) {
    activeCategory = category;
    filterButtons.forEach(button => {
      if (button.dataset.category === category) {
        button.classList.add('active');
      } else {
        button.classList.remove('active');
      }
    });
  }

  function filterListings() {
    const query = normalize(searchInput.value);
    let matched = 0;

    listingCards.forEach(card => {
      const title = normalize(card.dataset.title);
      const location = normalize(card.dataset.location);
      const country = normalize(card.dataset.country);
      const category = deriveCategory(card);
      const searchMatch = !query || [title, location, country, category].some(value => value.includes(query));
      const categoryMatch = activeCategory === 'Trending' || activeCategory === 'all' || category === activeCategory;

      const visible = searchMatch && categoryMatch;
      card.style.display = visible ? 'block' : 'none';
      if (visible) matched += 1;
    });

    updateResults(matched, listingCards.length);
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      setActiveCategory(button.dataset.category);
      filterListings();
    });
  });

  searchInput.addEventListener('input', () => filterListings());
  setActiveCategory('Trending');
  updateResults(listingCards.length, listingCards.length);
</script>
